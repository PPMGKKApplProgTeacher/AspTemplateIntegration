@{
    ViewData["Title"] = "Home Page";
}

<div class="main-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="top-text header-text">
                    <h6>Over 36,500+ Active Listings</h6>
                    <h2>Find Nearby Places &amp; Things</h2>
                </div>
            </div>
            <div class="col-lg-12">
                <form id="search-form" name="gs" method="submit" role="search" action="#">
                    <div class="row">
                        <div class="col-lg-3 align-self-center">
                            <fieldset>
                                <select name="area" class="form-select" aria-label="Area" id="chooseCategory" onchange="this.form.click()">
                                    <option selected>All Areas</option>
                                    <option value="New Village">New Village</option>
                                    <option value="Old Town">Old Town</option>
                                    <option value="Modern City">Modern City</option>
                                </select>
                            </fieldset>
                        </div>
                        <div class="col-lg-3 align-self-center">
                            <fieldset>
                                <input type="address" name="address" class="searchText" placeholder="Enter a location" autocomplete="on" required>
                            </fieldset>
                        </div>
                        <div class="col-lg-3 align-self-center">
                            <fieldset>
                                <select name="price" class="form-select" aria-label="Default select example" id="chooseCategory" onchange="this.form.click()">
                                    <option selected>Price Range</option>
                                    <option value="$100 - $250">$100 - $250</option>
                                    <option value="$250 - $500">$250 - $500</option>
                                    <option value="$500 - $1000">$500 - $1,000</option>
                                    <option value="$1000+">$1,000 or more</option>
                                </select>
                            </fieldset>
                        </div>
                        <div class="col-lg-3">
                            <fieldset>
                                <button class="main-button"><i class="fa fa-search"></i> Search Now</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-10 offset-lg-1">
                <ul class="categories">
                    @foreach (Category cat in ViewBag.cats)
                    {
                        <li><a href="/categories/edit/@cat.id"><span class="icon"><img src="@cat.Icon" alt="Home"></span> @cat.Name</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

</div>



<div class="popular-categories">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading">
                    <h2>Popular Categories</h2>
                    <h6>Check Them Out</h6>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="naccs">
                    <div class="grid">
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="menu">
                                    @foreach (Category cat in ViewBag.cats)
                                    {

                                        <div class="@(cat.id == 1 ? "first-thumb active" : "")">
                                            <div class="thumb">
                                                <span class="icon"><img src="@cat.Icon" alt=""></span>
                                                @cat.Name
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-lg-9 align-self-center">
                                <ul class="nacc">
                                    @foreach (Category cat in ViewBag.cats)
                                    {

                                        <li class="@(cat.id == 1 ? " active" : "")">
                                            <div>
                                                <div class="thumb">
                                                    <div class="row">
                                                        <div class="col-lg-5 align-self-center">
                                                            <div class="left-text">
                                                                <h4>@cat.Title</h4>
                                                                <p>@cat.Descr\</p>
                                                                <div class="main-white-button"><a href="/categories/edit/@cat.id"><i class="fa fa-eye"></i> Discover More</a></div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-7 align-self-center">
                                                            <div class="right-image">
                                                                <img src="@cat.Image" alt="">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="recent-listing">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading">
                    <h2>Recent Listing</h2>
                    <h6>Check Them Out</h6>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="owl-carousel owl-listing">

                    @foreach (Listing list in ViewBag.listings)
                    { 
                    <div class="item">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="listing-item">
                                    <div class="left-image">
                                        <a href="#"><img src="@list.Image" alt=""></a>
                                    </div>
                                    <div class="right-content align-self-center">
                                            <a href="/listings/edit/@list.id"><h4>@list.Title</h4></a>
                                        <h6>by: @list.Agent</h6>
                                        <span class="price"><div class="icon"><img src="assets/images/listing-icon-01.png" alt=""></div> @list.Rent</span>
                                        <span class="details">Details: <em>@list.Size sq m</em></span>
                                        <ul class="info">
                                            <li><img src="assets/images/listing-icon-02.png" alt=""> @list.Bedrooms Bedrooms</li>
                                            <li><img src="assets/images/listing-icon-03.png" alt=""> @list.Bathrooms Bathrooms</li>
                                        </ul>
                                        <div class="main-white-button">
                                            <a href="contact.html"><i class="fa fa-eye"></i> Contact Now</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

